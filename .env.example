# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rethlab?schema=public"

# NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-here"
AUTH_TRUST_HOST="true"

# OAuth Providers
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dev auth (set to "true" to enable dev credentials login — leave "false" in production)
ENABLE_DEV_AUTH="false"
NEXT_PUBLIC_ENABLE_DEV_AUTH="false"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (one-time donations)
STRIPE_SECRET_KEY=""

# GitHub Sponsors
NEXT_PUBLIC_GITHUB_SPONSORS_URL="https://github.com/sponsors/psyto"
